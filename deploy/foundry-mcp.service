[Unit]
Description=Foundry VTT MCP server (headless)
After=network.target foundry.service

[Service]
User=foundrymcp
WorkingDirectory=/opt/foundry-vtt-mcp-server
# Local Foundry URL (no need to go through the reverse proxy).
Environment=FOUNDRY_URL=http://127.0.0.1:30000
Environment=PORT=8808
Environment=HOST=127.0.0.1
# Reverse proxy IP (trusted for X-Forwarded-For and rate limiting).
Environment=TRUSTED_PROXY=
# Public Foundry URL used for uploaded-file links.
Environment=PUBLIC_URL=
ExecStart=/usr/bin/node /opt/foundry-vtt-mcp-server/src/server.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
